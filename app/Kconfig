menu "Demo Application"

config APP_BLINKY_ENABLED
	bool "Enable application blinky"

choice APP_LOG_VERBOSITY
	prompt "App log verbosity"
	default APP_LOG_VERBOSITY_INF

config APP_LOG_VERBOSITY_DBG
	bool "Debug"

config APP_LOG_VERBOSITY_INF
	bool "Info"

config APP_LOG_VERBOSITY_WEN
	bool "Warning"

endchoice

endmenu

menuconfig LED_SUBSYSTEM
	bool "LED Subsystem"
	default y

if LED_SUBSYSTEM

choice LED_BLINK_SLEEP
	prompt "LED blink sleep time"
	default LED_BLINK_SLEEP_MEDIUM

config LED_BLINK_SLEEP_FAST
	bool "500ms (fast)"

config LED_BLINK_SLEEP_MEDIUM
	bool "1s (medium)"

config LED_BLINK_SLEEP_SLOW
	bool "2s (slow)"

endchoice

config LED_BLINK_SLEEP_MS
	int
	default 500 if LED_BLINK_SLEEP_FAST
	default 1000 if LED_BLINK_SLEEP_MEDIUM
	default 2000 if LED_BLINK_SLEEP_SLOW

menuconfig LED_ADVANCED
	bool "Advanced LED settings"
	default n

if LED_ADVANCED

config LED_BRIGHTNESS
	int "LED brightness (0-100)"
	default 100
	range 0 100

config LED_FADE_DURATION
	int "LED fade duration (ms)"
	default 500
	range 0 5000

menu "Expert settings"

config LED_DEBUG
	bool "Enable LED debugging"
	default n

config LED_CUSTOM_BLINK
	bool "Custom blink pattern"
	default n

endmenu

endif # LED_ADVANCED

endif # LED_SUBSYSTEM

rsource "Kconfig.heartbeat"

source "Kconfig.zephyr"
